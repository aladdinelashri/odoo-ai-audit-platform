cd ~/odoo-ai-audit-platform
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
dist/
build/

# Virtual Environment
.venv/
venv/
env/

# Environment & Secrets
.env
.env.local

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Cache
database/cache/
.pytest_cache/
.mypy_cache/

# Database files (ALL of them)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite3-journal
database/storage/*.db

# Backups
backup*/
*.save
*.bak

# Archives
*.tar
*.tar.gz
*.zip

# Exports
database/exports/raw/*.xlsx

# Alembic (if not using it)
# alembic/
# alembic.ini

# Junk
-H
-d
=0.*
EOF

# Junk files
-H
-d
=0.*
